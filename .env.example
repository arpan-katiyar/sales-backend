NODE_ENV=development
PORT=8081
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=csmdb

# At least 32 characters each. Use different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1800
# Hard end of a login, even if the user keeps working. 12 hours.
JWT_SESSION_TTL_SECONDS=43200
BCRYPT_COST=12

FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Used only by npm run db:seed. Leave blank to skip seeding.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
